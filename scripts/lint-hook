#!/usr/bin/env bash

# Hook script for Claude Code to run after markdown file changes
# This script is called by Claude Code's PostToolUse hook

# Resolve script directory (works whether invoked from plugin or directly)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Parse the JSON to get the file path.
# Claude Code delivers the PostToolUse payload as JSON on stdin (shape:
# {"tool_input":{"file_path":"..."}}), not via an env var. Prefer jq; fall back
# to grep/sed if jq is absent. (CLAUDE_TOOL_ARGS is honored as a legacy fallback.)
PAYLOAD="$(cat)"
[ -z "$PAYLOAD" ] && PAYLOAD="${CLAUDE_TOOL_ARGS:-}"
if command -v jq >/dev/null 2>&1; then
    FILE_PATH=$(printf '%s' "$PAYLOAD" | jq -r '.tool_input.file_path // .file_path // empty')
else
    FILE_PATH=$(printf '%s' "$PAYLOAD" | grep -o '"file_path"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"file_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
fi

# Check if it's a markdown file
if [[ "$FILE_PATH" == *.md ]]; then
    echo "🔍 Linting markdown: $(basename "$FILE_PATH")"

    # Run the lint script with fix flag
    if "$SCRIPT_DIR/lint" --fix "$FILE_PATH" 2>&1 | grep -E "(✓|✅|⚠️|Clean|Fixed)" | head -3; then
        exit 0
    else
        echo "   Run './scripts/lint --fix $FILE_PATH' for details"
        exit 0
    fi
fi
