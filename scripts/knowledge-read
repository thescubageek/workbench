#!/usr/bin/env bash

# Scoped, bounded retrieval from the knowledge store's PROMOTED entries.
#
# The read half of the loop. Callers — commands/create_research.md Step 0,
# commands/resume_handoff.md Step 4 — treat the result as high-priority scoping
# input: it shapes WHERE you look, not WHAT you conclude.
#
# THE INVARIANT: this reads `entries/` and nothing else. Staged content is
# ungated, auto-captured and unreviewed. If retrieval could surface it, ungated
# content would steer future tickets — precisely the vector the promotion gate
# exists to close. There is no flag to include it, and passing one is an error.
#
# WHY A SCRIPT RATHER THAN INSTRUCTIONS IN A COMMAND
#
#   Retrieval's failure modes are silent: the wrong entries surface, or too many,
#   or ungated ones. Specified as prose in a markdown command, none of that is
#   testable — this repo has no way to test markdown, and `./scripts/lint` checks
#   formatting only. As a script it gets a contract test, and what remains in
#   markdown shrinks to "does the command call this", which is a grep.
#
# WHY BOUNDED, ALWAYS
#
#   Retrieval noise and negative transfer are the measured failure modes and both
#   worsen as the store grows. A wholesale load is not a generous default, it is
#   the documented way to make the store make things worse. So there is a default
#   limit, a hard ceiling above it, and a default SCOPE — never "everything".
#
# Exit codes: 0 read (possibly zero matches) · 3 no .wb-knowledge.json ·
#             4 store unreachable · 64 usage
#
# Callers must treat any non-zero as "no knowledge available" and CONTINUE. The
# read path is best-effort and never blocking (create_research.md:60).

set -uo pipefail

NAME="knowledge-read"
DEFAULT_LIMIT=5
HARD_CEILING=25

SCOPES=()
LIMIT=""
PATHS_ONLY=0

die() { echo "$NAME: $2" >&2; exit "$1"; }

usage() {
    cat <<'USAGE'
Usage: knowledge-read [--scope TAG]... [--limit N] [--paths]

Returns promoted knowledge entries matching any of the given scope tags, ranked
and bounded. Reads promoted entries only.

  --scope TAG   repeatable; OR-ed. Defaults to repo:<this repo> if omitted
  --limit N     max entries (default 5, hard ceiling 25)
  --paths       print file paths only

Ranking: more matching scope tags first, then higher confidence, then id.
Deprecated entries are never returned.

Exit 0 even with zero matches. Non-zero means no knowledge is available — the
caller should continue without it, never halt.
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h | --help) usage; exit 0 ;;
        --scope) [[ $# -ge 2 ]] || die 64 "--scope needs a value"; SCOPES+=("$2"); shift 2 ;;
        --limit) [[ $# -ge 2 ]] || die 64 "--limit needs a value"; LIMIT="$2"; shift 2 ;;
        --paths) PATHS_ONLY=1; shift ;;
        --staging | --include-staging | --all)
            die 64 "there is no way to retrieve staged entries, and that is deliberate. Staged content is ungated, auto-captured and unreviewed; surfacing it would let content nothing has reviewed steer the next ticket, which is the exact vector the promotion gate exists to close. Promote it first."
            ;;
        *) usage >&2; exit 64 ;;
    esac
done

# --- Locate the store --------------------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

find_config() {
    local d="$1"
    while [[ -n "$d" && "$d" != "/" ]]; do
        [[ -f "$d/.wb-knowledge.json" ]] && { printf '%s' "$d"; return 0; }
        d="${d%/*}"
    done
    return 1
}

REPO="$(find_config "$PWD")" \
    || die 3 "no .wb-knowledge.json at or above $PWD — this repo declares no knowledge store"
REPO="$(cd "$REPO" && pwd -P)"

STORE="$("$SCRIPT_DIR/knowledge-worktree" 2>/dev/null)"
if [[ -z "$STORE" || ! -d "$STORE" ]]; then
    if [[ -d "$REPO/knowledge/entries" ]]; then
        STORE="$REPO/knowledge"
    else
        die 4 "the knowledge store is unreachable — run scripts/knowledge-worktree to see why. Continue without it."
    fi
fi

PROMOTED="$STORE/entries"
[[ -d "$PROMOTED" ]] || die 4 "the store at $STORE has no promoted entries directory"

# Default scope. Not "everything" — see the header: an unscoped wholesale load is
# the documented way to make the store actively harmful as it grows.
if [[ ${#SCOPES[@]} -eq 0 ]]; then
    SCOPES=("repo:$(basename "$REPO")")
fi

if [[ -z "$LIMIT" ]]; then
    LIMIT="$DEFAULT_LIMIT"
fi
case "$LIMIT" in
    ''|*[!0-9]*) die 64 "--limit must be a positive integer" ;;
esac
[[ "$LIMIT" -lt 1 ]] && LIMIT=1
[[ "$LIMIT" -gt $HARD_CEILING ]] && LIMIT=$HARD_CEILING

# --- Frontmatter reading -----------------------------------------------------

field() { grep -m1 "^$2:" "$1" 2>/dev/null | sed "s/^$2:[[:space:]]*//" | tr -d '\r' | sed 's/[[:space:]]*$//'; }

tags() {
    sed -n '/^scope:/,/^[a-z_]*:/p' "$1" 2>/dev/null \
        | grep -E '^[[:space:]]+-[[:space:]]' \
        | sed 's/^[[:space:]]*-[[:space:]]*//' \
        | tr -d '\r' | sed 's/[[:space:]]*$//'
}

conf_rank() {
    case "$1" in
        high) echo 3 ;;
        medium) echo 2 ;;
        low) echo 1 ;;
        *) echo 0 ;;
    esac
}

# --- Select ------------------------------------------------------------------

RANKED=""
while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    case "$(basename "$f")" in
        README.md | INDEX.md | SCHEMA.md) continue ;;
    esac

    # Only promoted entries are retrievable. A `staged` file sitting in the
    # promoted tree is a mistake, not an invitation.
    [[ "$(field "$f" status)" == "promoted" ]] || continue

    entry_tags="$(tags "$f")"
    matches=0
    for want in "${SCOPES[@]}"; do
        while IFS= read -r have; do
            [[ "$have" == "$want" ]] && matches=$((matches + 1))
        done <<< "$entry_tags"
    done
    [[ $matches -gt 0 ]] || continue

    id="$(field "$f" id)"
    [[ -n "$id" ]] || id="$(basename "$f" .md)"
    RANKED+="$matches|$(conf_rank "$(field "$f" confidence)")|$id|$f"$'\n'
done < <(find "$PROMOTED" -maxdepth 2 -type f -name '*.md' 2>/dev/null | sort)

[[ -n "${RANKED//[[:space:]]/}" ]] || exit 0

# More matching tags first — specificity beats recency. Then confidence, so a
# caller weighting the result is not handed a low-confidence entry over a high
# one that fit equally well.
SELECTED="$(printf '%s' "$RANKED" | grep -v '^$' | sort -t'|' -k1,1nr -k2,2nr -k3,3 | head -n "$LIMIT")"

# --- Emit --------------------------------------------------------------------

while IFS='|' read -r _m _c id file; do
    [[ -n "$file" ]] || continue
    if [[ $PATHS_ONLY -eq 1 ]]; then
        printf '%s\n' "$file"
        continue
    fi
    echo "id: $id"
    echo "confidence: $(field "$file" confidence)"
    echo "origin: $(field "$file" origin)"
    echo "scope: $(tags "$file" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    echo "path: $file"
    echo "---"
    # The claim body: everything after the closing frontmatter delimiter.
    awk 'NR==1 && $0=="---" {fm=1; next} fm && $0=="---" {fm=0; body=1; next} body' "$file"
    echo ""
done <<< "$SELECTED"

exit 0
