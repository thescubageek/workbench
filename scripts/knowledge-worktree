#!/usr/bin/env bash

# Resolve (and if necessary create) the knowledge store checkout for this repo,
# printing the absolute path to the store root on stdout.
#
# The store lives on a long-lived branch declared in .wb-knowledge.json. Git
# permits a branch to be checked out in only one worktree at a time, so this
# script RESOLVES to an existing checkout wherever it already is — including a
# sibling Conductor workspace — rather than competing for one. Parallel
# workspaces therefore share a single store, which is the point: a capture made
# in one is visible to a curation pass run from another.
#
# Contract, asserted by scripts/test-knowledge-worktree:
#   - stdout is the store root path and nothing else, on success
#   - every failure is non-zero, legible, and on stderr
#   - repeated runs return the identical path and create nothing extra
#
# A silent no-op is worse than no capture at all: it looks like the loop is
# recording when nothing is being written. Hence: no fallback to a local
# directory, no "best effort" success. If the store is unreachable, say so.
#
# Exit codes:
#   2  not inside a git repository
#   3  repo declares no store (.wb-knowledge.json absent or unparseable)
#   4  the declared store branch does not exist
#   5  the store checkout exists but has no store root
#   6  creating the worktree failed

set -uo pipefail

die() {
    local code="$1"; shift
    echo "knowledge-worktree: $*" >&2
    exit "$code"
}

case "${1:-}" in
    -h|--help)
        cat <<'USAGE'
Usage: knowledge-worktree

Prints the absolute path to this repo's knowledge store root.

Reads .wb-knowledge.json at the repo root for store.branch and store.root.
Resolves to an existing checkout of the store branch if one exists anywhere in
this repository's worktrees; otherwise creates a worktree for it.

Environment:
  WB_KNOWLEDGE_WORKTREE   Where to create the worktree, if one must be created.
                          Defaults to a sibling of the repo root.
  WB_KNOWLEDGE_NO_JQ      Set to 1 to force the jq-free parsing fallback.
USAGE
        exit 0
        ;;
esac

# --- Locate the repo ---------------------------------------------------------

TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null)"
[[ -n "$TOPLEVEL" ]] || die 2 "not inside a git repository (run this from within the repo that declares the store)"

CONFIG="$TOPLEVEL/.wb-knowledge.json"
[[ -f "$CONFIG" ]] || die 3 "no .wb-knowledge.json at $TOPLEVEL — this repo does not declare a knowledge store"

# --- Parse the store declaration ---------------------------------------------
# Same jq-then-fallback idiom as scripts/lint-hook: jq when present, grep/sed
# when it is not, so the script works on a bare machine.

read_key() {
    local key="$1"
    if [[ "${WB_KNOWLEDGE_NO_JQ:-0}" != "1" ]] && command -v jq >/dev/null 2>&1; then
        jq -r --arg k "$key" '.store[$k] // empty' "$CONFIG"
    else
        # Single occurrence of the key inside the store object. Adequate for a
        # config this small; jq is the real path.
        grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$CONFIG" \
            | head -1 \
            | sed "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/"
    fi
}

BRANCH="$(read_key branch)"
STORE_ROOT_REL="$(read_key root)"
STORE_ROOT_REL="${STORE_ROOT_REL:-knowledge}"

[[ -n "$BRANCH" ]] || die 3 "$CONFIG declares no store.branch"

# --- Confirm the branch exists somewhere -------------------------------------

HAS_LOCAL=0
HAS_REMOTE=0
git show-ref --verify --quiet "refs/heads/$BRANCH" && HAS_LOCAL=1
git show-ref --verify --quiet "refs/remotes/origin/$BRANCH" && HAS_REMOTE=1

if [[ $HAS_LOCAL -eq 0 && $HAS_REMOTE -eq 0 ]]; then
    die 4 "store branch '$BRANCH' does not exist locally or on origin — create it, or fix store.branch in $CONFIG"
fi

# --- Find an existing checkout of that branch --------------------------------
# `git worktree list --porcelain` emits records of: worktree <path>, HEAD <sha>,
# branch <ref>. The current worktree is included, so this covers both "we are
# already on the store branch" and "a sibling workspace holds it".

CHECKOUT=""
current_path=""
while IFS= read -r line; do
    case "$line" in
        "worktree "*) current_path="${line#worktree }" ;;
        "branch refs/heads/$BRANCH")
            CHECKOUT="$current_path"
            break
            ;;
    esac
done < <(git worktree list --porcelain 2>/dev/null)

# --- Create one if nothing holds the branch ----------------------------------

if [[ -z "$CHECKOUT" ]]; then
    target="${WB_KNOWLEDGE_WORKTREE:-$(dirname "$TOPLEVEL")/.wb-knowledge-$(basename "$TOPLEVEL")}"

    if [[ -d "$target" ]] && [[ -n "$(ls -A "$target" 2>/dev/null)" ]]; then
        die 6 "cannot create the store worktree: $target already exists and is not empty"
    fi

    if [[ $HAS_LOCAL -eq 1 ]]; then
        git worktree add "$target" "$BRANCH" >/dev/null 2>&1 \
            || die 6 "git worktree add '$target' '$BRANCH' failed"
    else
        git worktree add --track -b "$BRANCH" "$target" "origin/$BRANCH" >/dev/null 2>&1 \
            || die 6 "git worktree add --track -b '$BRANCH' '$target' 'origin/$BRANCH' failed"
    fi
    CHECKOUT="$target"
fi

# --- Resolve and hand back the store root ------------------------------------

CHECKOUT="$(cd "$CHECKOUT" 2>/dev/null && pwd -P)" \
    || die 6 "the store checkout path is not reachable"

STORE_ROOT="$CHECKOUT/$STORE_ROOT_REL"
[[ -d "$STORE_ROOT" ]] \
    || die 5 "store branch '$BRANCH' is checked out at $CHECKOUT but has no '$STORE_ROOT_REL' directory"

printf '%s\n' "$STORE_ROOT"
