{
  "_about": "Exempt tokens and parser patterns. Source of truth: plugin/docs/reference/technical-english.md, section Exempt tokens. Read by evals/token_check.py.",
  "patterns": {
    "id_shape": "^[A-Z0-9-]*[0-9][A-Z0-9-]*$",
    "bold_task_line": "^- \\[[ x]\\] \\*\\*([A-Z0-9-]+)\\*\\*",
    "task_done": "^- \\[x\\] \\*\\*[A-Z0-9-]*[0-9][A-Z0-9-]*\\*\\*",
    "task_open": "^- \\[ \\] \\*\\*[A-Z0-9-]*[0-9][A-Z0-9-]*\\*\\*",
    "journal_heading": "^## ",
    "journal_placeholder": "\\[YYYY|<YYYY|YYYY-MM-DD",
    "journal_suffix": "\\((open|closed)\\)\\s*$",
    "checkpoint_heading": "^### ⛔ CHECKPOINT:",
    "checkpoint_end": "^(## |---\\s*$|### ⛔ CHECKPOINT:)",
    "checkpoint_label": "\\*\\*\\((derivable|attestation)\\)\\*\\*",
    "checkpoint_min_labels": 4,
    "checkpoint_phrase": "Go by the label, never by position"
  },
  "frontmatter": {
    "required_all": ["project", "created", "status", "last_updated", "git_commit", "git_branch"],
    "required_tasks": ["task_tracking", "current_phase", "total_tasks", "completed_tasks"],
    "status_values": {
      "research": ["draft", "in-progress", "complete"],
      "design": ["draft", "approved"],
      "tasks": ["not-started", "in-progress", "complete"]
    }
  },
