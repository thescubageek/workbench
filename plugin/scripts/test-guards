#!/usr/bin/env bash

# Contract tests for scripts/check-guards.
#
# The contract is one thing: the checker must be able to FAIL, on the thing it claims to
# catch. Every case plants a defect and asserts it fires — naming WHICH finding it expects —
# or plants the correct form and asserts nothing fires.
#
# Asserting only the exit code is not enough, and that is not hypothetical: an earlier
# version of this file did exactly that, and breaking check-guards' closing-fence reset left
# it 19/19 green while the checker flagged plain English prose. An expect-1 case that does
# not say what it expects cannot tell "found the planted defect" from "crashed".
#
# Usage: plugin/scripts/test-guards [path-to-check-guards]

set -uo pipefail
CG="${1:-$(cd "$(dirname "$0")" && pwd)/check-guards}"
pass=0; fail=0

CAPTURE="grep -c captured without a status guard"
GLOB="for over a glob with no existence test"
INCLUDE="unquoted --include glob"
FENCE="unclosed bash fence"

case_run() {  # name expect_exit expect_pattern file_rel content
  local name="$1" expect="$2" pattern="$3" rel="$4" content="$5"
  local d; d=$(mktemp -d)
  mkdir -p "$d/$(dirname "$rel")"
  printf '%b' "$content" > "$d/$rel"
  local out; out=$("$CG" "$d" 2>&1); local code=$?

  local ok=1 why=""
  if [ "$code" -ne "$expect" ]; then
    ok=0; why="expected exit $expect, got $code"
  elif [ "$expect" -eq 1 ] && ! printf '%s' "$out" | grep -qF -- "$pattern"; then
    ok=0; why="exit 1, but no finding matching: $pattern"
  elif [ "$expect" -eq 1 ] && ! printf '%s' "$out" | grep -qF -- "$(basename "$rel")"; then
    ok=0; why="fired, but not on the planted file $rel"
  elif [ "$expect" -eq 0 ] && printf '%s' "$out" | grep -q 'found:'; then
    ok=0; why="exit 0 but a finding was still reported"
  fi

  if [ "$ok" -eq 1 ]; then
    echo "  ✓ $name"; pass=$((pass+1))
  else
    echo "  ✗ $name — $why"; printf '%s\n' "$out" | sed 's/^/      /'; fail=$((fail+1))
  fi
  rm -rf "$d"
}

echo "== shape 1: an unguarded counting capture MUST fire =="
case_run "capture on the file's LAST line"       1 "$CAPTURE" scripts/a.sh '#!/usr/bin/env bash\necho hi\nn=$(grep -c foo /etc/hosts)\n'
case_run "piped grep -c"                         1 "$CAPTURE" scripts/b.sh '#!/usr/bin/env bash\nn=$(cat f.txt | grep -c foo)\necho "$n"\n'
case_run "backticked capture"                    1 "$CAPTURE" scripts/c.sh '#!/usr/bin/env bash\nn=`grep -c foo f.txt`\necho "$n"\n'
case_run "spaced \$( grep -c"                    1 "$CAPTURE" scripts/d.sh '#!/usr/bin/env bash\nn=$( grep -c foo f.txt )\necho "$n"\n'
case_run "--count long form"                     1 "$CAPTURE" scripts/e.sh '#!/usr/bin/env bash\nn=$(grep --count foo f.txt)\necho "$n"\n'
case_run "guard on a LATER capture, same line"   1 "$CAPTURE" scripts/q.sh '#!/usr/bin/env bash\nn=`grep -c x f`; m=`grep -c y g || true`\necho hi\n'
case_run "an earlier grep inside a string"       1 "$CAPTURE" scripts/r.sh '#!/usr/bin/env bash\necho "grep || true"; n=$(grep -c x f)\necho hi\n'

echo "== shape 2: an unquoted --include glob MUST fire =="
case_run "unquoted --include glob"               1 "$INCLUDE" scripts/g.sh '#!/usr/bin/env bash\ngrep -r --include=*.py foo .\n'

echo "== shape 3: an unguarded glob loop MUST fire =="
case_run "for over a glob, unguarded"            1 "$GLOB" scripts/h.sh '#!/usr/bin/env bash\nfor x in *.txt; do\n  echo "$x"\ndone\n'
case_run "guard placed past the window"          1 "$GLOB" scripts/i.sh '#!/usr/bin/env bash\nfor x in *.txt; do\n  a=1\n  b=2\n  c=3\n  echo "$x"\ndone\n'
case_run "echo -e does not cancel the check"     1 "$GLOB" scripts/s.sh '#!/usr/bin/env bash\nfor x in *.log; do\n  echo -e "processing $x"\n  cat "$x"\ndone\n'
case_run "the word continue in a string neither" 1 "$GLOB" scripts/u.sh '#!/usr/bin/env bash\nfor x in *.log; do\n  msg="continue anyway"\n  cat "$x"\ndone\n'

echo "== fenced blocks inside markdown MUST be scanned =="
case_run "an INDENTED bash fence"                1 "$CAPTURE" doc.md  'text\n\n   ```bash\n   n=$(grep -c foo f.txt)\n   echo "$n"\n   ```\n'
case_run "a fence ending on the capture"         1 "$CAPTURE" doc2.md 'text\n\n```bash\necho hi\nn=$(grep -c foo f.txt)\n```\n'
case_run "a fence with an info string"           1 "$CAPTURE" doc6.md '```bash copy\nn=$(grep -c foo f.txt)\necho "$n"\n```\n'
case_run "an sh fence, not just bash"            1 "$CAPTURE" doc7.md '```sh\nn=$(grep -c foo f.txt)\necho "$n"\n```\n'

echo "== a fence that never terminates MUST be reported, not leaked past =="
case_run "closed at a different indent"          1 "$FENCE" doc4.md 'text\n\n  ```bash\n  n=$(count foo f) || exit 2\n'
case_run "never closed at all"                   1 "$FENCE" doc5.md 'text\n\n```bash\nn=$(count foo f) || exit 2\n'

echo "== the correct forms MUST NOT fire =="
case_run "guarded with plugin/scripts/count"     0 "" scripts/j.sh '#!/usr/bin/env bash\nn=$(count foo f.txt) || exit 2\necho "$n"\n'
case_run "capture with a trailing || true"       0 "" scripts/k.sh '#!/usr/bin/env bash\nn=$(grep -c foo f.txt) || true\necho "${n:-0}"\n'
case_run "|| true inside the substitution"       0 "" scripts/v.sh '#!/usr/bin/env bash\nn=$(cat f | grep -c . || true)\necho "${n:-0}"\n'
case_run "status checked on the next line"       0 "" scripts/l.sh '#!/usr/bin/env bash\nn=$(grep -c foo f.txt)\nif [ $? -ge 2 ]; then exit 2; fi\n'
case_run "quoted --include glob"                 0 "" scripts/m.sh '#!/usr/bin/env bash\ngrep -r --include="*.py" foo .\n'
case_run "glob loop WITH a guard"                0 "" scripts/n.sh '#!/usr/bin/env bash\nfor x in *.txt; do\n  [ -e "$x" ] || continue\n  echo "$x"\ndone\n'
case_run "guard after a comment line"            0 "" scripts/o.sh '#!/usr/bin/env bash\nfor x in *.txt; do\n  # the guard is below\n  [ -e "$x" ] || continue\n  echo "$x"\ndone\n'
case_run "array expansion, not a glob"           0 "" scripts/p.sh '#!/usr/bin/env bash\narr=(a b)\nfor x in ${arr[*]}; do echo "$x"; done\n'
case_run "a trailing comment naming grep -c"     0 "" scripts/t.sh '#!/usr/bin/env bash\nn=$(count foo f.txt) || exit 2   # was: grep -c\necho "$n"\n'
case_run "prose in a scripts/*.md file"          0 "" scripts/README.md 'Never write `grep -r --include=*.py foo .` — quote the glob.\n'
case_run "an example in a text fence"            0 "" doc3.md 'Bad:\n\n```text\nn=$(grep -c foo f.txt)\n```\n'
case_run "a fence closed at its own indent"      0 "" doc8.md 'text\n\n  ```bash\n  n=$(count foo f) || exit 2\n  ```\n\nProse after.\n'

echo "== the scan itself must be verifiable =="
out=$("$CG" /tmp/no-such-dir-for-test-guards 2>&1); code=$?
if [ "$code" -eq 2 ]; then
  echo "  ✓ a nonexistent path exits 2 rather than reporting clean"; pass=$((pass+1))
else
  echo "  ✗ a nonexistent path should exit 2, got $code"; fail=$((fail+1))
fi

echo
echo "test-guards: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
