#!/usr/bin/env bash

# quiet - runner-agnostic output backpressure for the TDD/verification loop.
#
# Generalizes the markdown lint-hook pattern (run -> keep a marker line ->
# suppress the rest) to any command. A green run collapses to a single
# checkmark plus the command's own summary line; a red run dumps the full
# captured log so no failure detail is ever lost. The wrapped command's exit
# code is always passed through unchanged so exit-code checks keep working.
#
# Usage:
#   scripts/quiet <command> [args...]
#
# Examples:
#   scripts/quiet pytest -q
#   scripts/quiet make test
#   scripts/quiet go test ./...

set -uo pipefail

if [[ $# -eq 0 ]]; then
    echo "usage: quiet <command> [args...]" >&2
    exit 2
fi

LOG="$(mktemp "${TMPDIR:-/tmp}/wb-quiet.XXXXXX")"

"$@" >"$LOG" 2>&1
code=$?

if [[ $code -eq 0 ]]; then
    # Success: collapse to a checkmark + the runner's own summary line.
    # Keep the log so the advertised path is real if detail is ever needed.
    # grep -c exits 1 on no match and 2 on error, so an unguarded capture yields an
    # empty string when the log is missing and prints "( lines suppressed)".
    lines=$(grep -c . "$LOG" 2>/dev/null) || true
    summary=$(grep . "$LOG" | tail -1)
    echo "✓ $* (${lines:-0} lines suppressed → ${LOG})"
    [[ -n "$summary" ]] && echo "  $summary"
else
    # Failure: dump everything verbatim, then discard the temp file.
    cat "$LOG"
    rm -f "$LOG"
fi

exit $code
