#!/usr/bin/env bash

# Predicate-level contract test for scripts/pr-identity.
# One scratch world per scenario (S1 to S11 from the identity tracer bullet, plus N1 and O1 so
# that every relation value has a world). A stub gh reads a per-world fixture; git is real and
# pushes only into bare repositories under the scratch directory.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PRID="$SCRIPT_DIR/pr-identity"
STUB="$SCRIPT_DIR/fixtures/gh-stub"
ROOT="$(cd "$(mktemp -d)" && pwd -P)"
trap 'rm -rf "$ROOT"' EXIT

mkdir -p "$ROOT/bin"
ln -s "$STUB" "$ROOT/bin/gh"
export PATH="$ROOT/bin:$PATH"
export GIT_CONFIG_GLOBAL="$ROOT/gitconfig" GIT_CONFIG_NOSYSTEM=1
printf '[user]\n\tname = t\n\temail = t@example.invalid\n[init]\n\tdefaultBranch = main\n[advice]\n\tdetachedHead = false\n' >"$GIT_CONFIG_GLOBAL"

PASS=0
FAIL=0

must() { "$@" || { echo "world build failed: $*" >&2; exit 2; }; }
record() { echo "$1=$(git rev-parse HEAD)" >>"$OIDS"; }
commit() { echo "$1" >"$1.txt"; git add "$1.txt"; git commit -qm "$1"; record "$1"; }
oid() { sed -n "s/^$1=//p" "$OIDS"; }
pr() { # number headRefName oid cross owner
  printf '"%s": {"number": %s, "headRefName": "%s", "headRefOid": "%s", "baseRefName": "main", "isCrossRepository": %s, "headRepository": {"name": "workbench"}, "headRepositoryOwner": {"login": "%s"}, "isDraft": true}' "$1" "$1" "$2" "$3" "$4" "$5"
}

base_world() {
    W="$ROOT/w/$1"; OIDS="$W/oids"; rm -rf "$W"; mkdir -p "$W"; cd "$W" || exit 2
    : >"$OIDS"
    git init -q --bare parent.git
    git clone -q parent.git seed 2>/dev/null; cd seed || exit 2
    mkdir plugin; echo a >plugin/a.txt; printf 'docs/plans/\n' >.gitignore
    git add .; git commit -qm base; record base; must git push -q origin main
    git checkout -qb feature-A; commit A1; must git push -q origin feature-A
    must git push -q origin "$(oid A1):refs/pull/42/head"
    git checkout -q main; cd "$W" || exit 2
    REPOS="\"$W/parent.git\": \"thescubageek/workbench\""
}

fork_pr57() {
    git clone -q --bare parent.git fork.git
    cd seed || exit 2; git remote add fork "$W/fork.git"; git checkout -qb f main; commit F1
    must git push -q fork "+f:feature-A"
    must git push -q origin "$(oid F1):refs/pull/57/head"
    git checkout -q main; cd "$W" || exit 2
    REPOS="$REPOS, \"$W/fork.git\": \"contributor/workbench\""
}

fixture() { printf '{"repos": {%s}, "prs": {"thescubageek/workbench": {%s}}}\n' "$REPOS" "$1" >"$W/fixture.json"; }

# build <scenario>: sets W, OIDS, HAS_TARGET, TARGET and leaves cwd in "$W/work"
build() {
    HAS_TARGET=0; TARGET=""
    case $1 in
        S1|S7|S9|S10)
            base_world "$1"; git clone -q parent.git work; cd work || exit 2
            git checkout -q feature-A; commit L1
            fixture "$(pr 42 feature-A "$(oid A1)" false thescubageek)"
            case $1 in S1) TARGET=42 ;; S7) TARGET=feature-A ;; S10) TARGET=plugin/ ;; esac ;;
        S2)
            base_world S2; git clone -q parent.git work; cd work || exit 2
            git checkout -q feature-A; git checkout -qb feature-B; commit B1; must git push -q -u origin feature-B
            fixture "$(pr 42 feature-A "$(oid A1)" false thescubageek), $(pr 43 feature-B "$(oid B1)" false thescubageek)"
            TARGET=42 ;;
        S3)
            base_world S3; git clone -q parent.git work; cd work || exit 2
            git checkout -q -b mine --track origin/feature-A
            fixture "$(pr 42 feature-A "$(oid A1)" false thescubageek)"; TARGET=42 ;;
        S4)
            base_world S4; git clone -q parent.git work; cd work || exit 2
            git checkout -q --detach origin/feature-A
            fixture "$(pr 42 feature-A "$(oid A1)" false thescubageek)"; TARGET=42 ;;
        S5)
            base_world S5; fork_pr57; git clone -q parent.git work; cd work || exit 2
            git checkout -q feature-A; commit M1
            fixture "$(pr 42 feature-A "$(oid A1)" false thescubageek), $(pr 57 feature-A "$(oid F1)" true contributor)"
            TARGET=57 ;;
        S6)
            base_world S6; fork_pr57; git clone -q parent.git work; cd work || exit 2
            git remote add fork "$W/fork.git"; git fetch -q fork
            git checkout -q -b feature-A --track fork/feature-A
            fixture "$(pr 57 feature-A "$(oid F1)" true contributor)"; TARGET=57 ;;
        S8)
            base_world S8; git clone -q parent.git work; cd work || exit 2
            git checkout -qb HEAD-fix main; commit H1; must git push -q -u origin HEAD-fix
            git checkout -qb feature-B main; commit B1; must git push -q -u origin feature-B
            fixture "$(pr 42 feature-A "$(oid A1)" false thescubageek), $(pr 43 feature-B "$(oid B1)" false thescubageek)"
            TARGET=HEAD-fix ;;
        S11)
            base_world S11; git clone -q --bare parent.git userfork.git
            REPOS="$REPOS, \"$W/userfork.git\": \"scraig/workbench\""
            git clone -q userfork.git work; cd work || exit 2
            git remote add upstream "$W/parent.git"; git fetch -q upstream
            # a bare `git checkout feature-A` is ambiguous when two remotes carry the branch
            git checkout -q -b feature-A --track origin/feature-A; commit L1
            fixture "$(pr 42 feature-A "$(oid A1)" false thescubageek)"; TARGET=42 ;;
        N1)
            base_world N1; git clone -q parent.git work; cd work || exit 2
            fixture "$(pr 42 feature-A "$(oid A1)" false thescubageek)" ;;
        O1)
            base_world O1; git clone -q parent.git work; cd work || exit 2
            git checkout -qb side main; commit O1
            fixture "$(pr 42 feature-A "$(oid A1)" false thescubageek)"; TARGET=42 ;;
    esac
    [ "$1" = S9 ] || [ "$1" = N1 ] || HAS_TARGET=1
    export GH_FIXTURE="$W/fixture.json" GH_LOG="$W/gh.log"
    : >"$GH_LOG"
}

# id | relation (alternatives with /) | fix | publish | world HEAD | review_head oid | push_remote | push_ref | why
TABLE='S1|own|yes|yes|L1|L1|origin|refs/heads/feature-A|own PR, local commit
S2|stacked/elsewhere|no|no|B1|A1|-|-|stacked on the PR, upstream is its own branch
S3|own|yes|yes|A1|A1|origin|refs/heads/feature-A|renamed branch tracking the PR head
S4|detached|no|no|A1|A1|-|-|detached at the PR head
S5|cross|no|no|M1|F1|-|-|same-name fork PR
S6|cross|no|no|F1|F1|-|-|cross-repository PR checked out
S7|own|yes|yes|L1|L1|origin|refs/heads/feature-A|branch target equal to the current branch
S8|branch|no|no|B1|H1|-|-|branch target HEAD-fix
S9|own|yes|yes|L1|L1|origin|refs/heads/feature-A|no argument
S10|own|yes|yes|L1|L1|origin|refs/heads/feature-A|path target
S11|stacked/elsewhere|no|no|L1|A1|-|-|two remotes, upstream is the fork
N1|none|yes|no|base|base|-|-|current checkout with no PR
O1|other|no|no|O1|A1|-|-|HEAD does not contain the PR head'

val() { printf '%s\n' "$OUT" | sed -n "s/^$1=//p" | head -1; }

fail() { echo "  ✗ $1: $2"; FAIL=$((FAIL + 1)); }

if [[ -x "$PRID" ]]; then MISSING=0; else MISSING=1; echo "plugin/scripts/pr-identity not found or not executable"; fi

while IFS='|' read -r id rel fix publish headname revname premote pref why; do
    build "$id" >/dev/null 2>&1
    cd "$W/work" || exit 2
    world_head=$(git rev-parse HEAD)
    if [[ "$(command -v gh)" != "$ROOT/bin/gh" ]] || [[ "$world_head" != "$(oid "$headname")" ]]; then
        fail "$id" "world did not build: HEAD ${world_head:0:7}, expected $headname $(oid "$headname" | cut -c1-7)"
        cd "$SCRIPT_DIR" || exit 2; continue
    fi
    if [[ $MISSING -eq 1 ]]; then
        fail "$id" "plugin/scripts/pr-identity not found ($why; world built, HEAD is $headname)"
        cd "$SCRIPT_DIR" || exit 2; continue
    fi
    if [[ $HAS_TARGET -eq 1 ]]; then OUT=$("$PRID" "$TARGET" 2>"$W/err"); else OUT=$("$PRID" 2>"$W/err"); fi
    rc=$?
    got_head=$(git rev-parse -q --verify "$(val review_head)^{commit}" 2>/dev/null || echo unresolved)
    problems=""
    [[ $rc -eq 0 ]] || problems="$problems exit=$rc;"
    [[ "/$rel/" == *"/$(val relation)/"* ]] || problems="$problems relation=$(val relation) want $rel;"
    [[ "$(val fix)" == "$fix" ]] || problems="$problems fix=$(val fix) want $fix;"
    [[ "$(val publish)" == "$publish" ]] || problems="$problems publish=$(val publish) want $publish;"
    [[ "$got_head" == "$(oid "$revname")" ]] || problems="$problems review_head=$(val review_head) -> ${got_head:0:7} want $revname;"
    [[ "$(val push_remote)" == "$premote" ]] || problems="$problems push_remote=$(val push_remote) want $premote;"
    [[ "$(val push_ref)" == "$pref" ]] || problems="$problems push_ref=$(val push_ref) want $pref;"
    if [[ -z "$problems" ]]; then
        echo "  ✓ $id $rel: $why"; PASS=$((PASS + 1))
    else
        fail "$id" "$why:$problems"
    fi
    cd "$SCRIPT_DIR" || exit 2
done <<<"$TABLE"

echo "test-pr-identity: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 && $MISSING -eq 0 ]]
