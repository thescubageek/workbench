{
  "$schema": "./.wb-knowledge.schema.json",
  "version": 1,
  "store": {
    "branch": "thescubageek/self-learning-loops-research",
    "root": "knowledge"
  },
  "protected_paths": [
    "commands/",
    "agents/",
    "skills/",
    "hooks/",
    "scripts/",
    ".claude-plugin/",
    ".claude/",
    "CLAUDE.md",
    "AGENTS.md",
    ".wb-knowledge.json",
    ".wb-knowledge.schema.json",
    "knowledge/entries/",
    "knowledge/SCHEMA.md"
  ],
  "write_policy": {
    "ordinary_entries": {
      "tool_verified": "propose-only",
      "model_narrated": "propose-only"
    }
  }
}
